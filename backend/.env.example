# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Local SQLite (development):
# DATABASE_URL=sqlite:///./test.db

# Supabase PostgreSQL (production) — get this from Supabase dashboard:
# Project Settings → Database → Connection string → URI mode
# Use the "Transaction pooler" URL (port 6543) for Render free tier
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Generate a strong random key — run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

APP_NAME=Jewellery Billing App

# Google Gemini API key — only needed for the "Scan Bill" feature
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=